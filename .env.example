# Server-only Supabase credentials. Prefer the newer secret key if your project has it.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
# Legacy fallback only if your project still uses it:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Razorpay LIVE credentials (use rzp_live_... only after the account is approved for Live Mode).
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-a-strong-webhook-secret

# Optional when the frontend is hosted separately (for example GitHub Pages).
# Comma-separated allowed browser origins. Do not include paths.
SITE_ORIGINS=https://xansar1.github.io

# Fixed contribution charges in INR.
# Donation remains custom-amount; every configured Puja/Seva/Sponsorship option is locked server-side.
# Add only organiser-approved amounts before enabling the relevant option.
PAYMENT_AMOUNT_PUJA_SEVA=
PAYMENT_AMOUNT_PUJA_PARTICIPATION=
PAYMENT_AMOUNT_YAJNA_SEVA=
PAYMENT_AMOUNT_ANNADANAM=
PAYMENT_AMOUNT_SPONSORSHIP_GENERAL=
PAYMENT_AMOUNT_SPONSOR_MAIN_CEREMONY=
PAYMENT_AMOUNT_SPONSOR_PUJA_SEVA=
PAYMENT_AMOUNT_SPONSOR_ACCOMMODATION=
PAYMENT_AMOUNT_SPONSOR_TRANSPORTATION=
PAYMENT_AMOUNT_SPONSOR_DRINKING_WATER=
PAYMENT_AMOUNT_SPONSOR_VENUE_INFRASTRUCTURE=
PAYMENT_AMOUNT_SPONSOR_MEDIA_DOCUMENTATION=
PAYMENT_AMOUNT_SPONSOR_LIVE_STREAMING=
PAYMENT_AMOUNT_SPONSOR_PUBLICATIONS=
PAYMENT_AMOUNT_SPONSOR_VISITOR_SERVICES=
